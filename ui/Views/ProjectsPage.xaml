<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Synka.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:loc="using:Synka.Views"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded">

    <!-- Ctrl+F jumps to the filter, as in every list Windows has. -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
    </Page.KeyboardAccelerators>

    <ScrollViewer Padding="28,20"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <!-- The Grid is what centres the 900-wide column. A MaxWidth StackPanel placed
             directly in the ScrollViewer is pushed right when its content is narrower
             than 900 and clipped at the window edge (the Projekt page's toggles went
             off screen with the pane open). Measured with UI Automation, 2026-10-19. -->
        <Grid>
        <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="{loc:T Sv='Projekt', En='Projects'}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Filter and refresh. The filter ignores case and accents, so
                 "kopmannen" finds "Köpmannen". Esc clears it; F5 refreshes. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox"
                         PlaceholderText="{loc:T Sv='Filtrera hubbar och projekt', En='Filter hubs and projects'}"
                         AutomationProperties.Name="{loc:T Sv='Filtrera hubbar och projekt', En='Filter hubs and projects'}"
                         TextChanged="OnFilterChanged"
                         KeyDown="OnFilterKeyDown" />
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Click="OnRefresh"
                        AutomationProperties.Name="{loc:T Sv='Uppdatera projektlistan från ACC', En='Refresh the project list from ACC'}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- The ring keeps its place when idle, so the button does not change width. -->
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="RefreshGlyph" Glyph="&#xE72C;" FontSize="14" />
                            <ProgressRing x:Name="RefreshSpinner"
                                          Width="16"
                                          Height="16"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                        </Grid>
                        <TextBlock Text="{loc:T Sv='Uppdatera', En='Refresh'}" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- Empty states: no engine, not signed in, loading, nothing found, nothing matches. -->
            <StackPanel x:Name="EmptyPanel"
                        Visibility="Collapsed"
                        Spacing="12"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center">
                <ProgressRing x:Name="EmptySpinner"
                              Width="32"
                              Height="32"
                              IsActive="False"
                              Visibility="Collapsed" />
                <TextBlock x:Name="EmptyText"
                           MaxWidth="520"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="EmptySignInButton"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:T Sv='Logga in med Autodesk', En='Sign in with Autodesk'}"
                        Click="OnSignIn" />
            </StackPanel>

            <!-- One SettingsExpander per hub is built in code. The cards are updated in
                 place when only their state changes, so focus and scroll stay put. -->
            <StackPanel x:Name="HubsPanel" Spacing="8" />

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
