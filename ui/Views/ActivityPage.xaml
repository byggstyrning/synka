<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Synka.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synka.Views"
    xmlns:loc="using:Synka.Views"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid Padding="28,20" RowSpacing="14" MaxWidth="900" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T Sv='Aktivitet', En='Activity'}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button x:Name="OpenLogButton"
                    Grid.Column="1"
                    Click="OnOpenLog"
                    AutomationProperties.Name="{loc:T Sv='Öppna loggmappen', En='Open log folder'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="{loc:T Sv='Öppna loggmappen', En='Open log folder'}" />
                </StackPanel>
            </Button>
            <Button x:Name="ClearActivityButton"
                    Grid.Column="2"
                    Click="OnClearActivity"
                    Content="{loc:T Sv='Rensa aktivitet', En='Clear activity'}"
                    AutomationProperties.Name="{loc:T Sv='Rensa aktivitetslistan', En='Clear the activity list'}" />
        </Grid>

        <!-- The filter and, beside it, what the engine's queue holds right now. -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterChoice"
                      MinWidth="240"
                      SelectedIndex="0"
                      SelectionChanged="OnFilterChanged"
                      AutomationProperties.Name="{loc:T Sv='Visa', En='Show'}">
                <ComboBoxItem Content="{loc:T Sv='Alla', En='All'}" Tag="all" />
                <ComboBoxItem Content="{loc:T Sv='Fel och konflikter', En='Errors and conflicts'}" Tag="problems" />
                <ComboBoxItem Content="{loc:T Sv='Överföringar', En='Transfers'}" Tag="transfers" />
            </ComboBox>
            <TextBlock x:Name="QueueText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <!-- Only while jobs have failed: put them back in the queue. -->
            <Button x:Name="RetryButton"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Content="{loc:T Sv='Försök igen', En='Retry'}"
                    AutomationProperties.Name="{loc:T Sv='Försök igen med de misslyckade ändringarna', En='Retry the failed changes'}"
                    Click="OnRetryFailed" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="EventList"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ContainerContentChanging="OnActivityContainerChanging"
                      GotFocus="OnActivityGotFocus"
                      LostFocus="OnActivityLostFocus"
                      AutomationProperties.Name="{loc:T Sv='Händelser', En='Events'}"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ActivityRow">
                        <Grid Padding="0,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- One glyph, in the colour of its kind: errors red, conflicts amber.
                                 Three icons with theme brushes rather than one brush set in code,
                                 so the colours follow the chosen theme. -->
                            <Grid VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Bind KindLabel}"
                                  ToolTipService.ToolTip="{x:Bind KindLabel}">
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="18"
                                          Visibility="{x:Bind NormalVisibility}" />
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind CautionVisibility}" />
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{x:Bind CriticalVisibility}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Visibility="{x:Bind FileTypeVisibility}"
                                            Height="22" Padding="4,0"
                                            CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind FileTypeGlyph}"
                                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                      FontSize="16"
                                                      AutomationProperties.Name="{x:Bind FileTypeDescription}"
                                                      ToolTipService.ToolTip="{x:Bind FileTypeDescription}" />
                                            <TextBlock Text="{x:Bind FileTypeLabel}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Subtitle}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{x:Bind HelpVisibility}">
                                    <HyperlinkButton Content="{loc:T Sv='Filtyper i ACC', En='ACC file types'}"
                                                     NavigateUri="https://help.autodesk.com/view/DOCS/ENU/?guid=Supported_Files_Docs"
                                                     Padding="0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind RelativeTime, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind AbsoluteTime}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,40,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{loc:T Sv='Inga händelser här ännu.', En='No events here yet.'}" />
        </Grid>
    </Grid>
</Page>
