<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Synka.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The Fluent controls. The toolkit's SettingsCard finds its own
                     styles by itself — a hand-added Generic.xaml kills the XAML
                     compiler without an error message.

                     No colours of our own anywhere: the theme follows the light or
                     dark mode of Windows and the system accent colour by itself. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
